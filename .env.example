# Copy to .env for local runs: `cp .env.example .env`.
# Every setting is optional — the defaults run the service with fakes and
# in-memory counts. Names match counter/config.py; the prefix is COUNTER_.

# dev = fake detector + in-memory counts (no infrastructure needed)
# prod = catalog models + relational persistence
COUNTER_ENV=dev

# --- API ---------------------------------------------------------------
COUNTER_HOST=0.0.0.0
COUNTER_PORT=5000
COUNTER_DEFAULT_THRESHOLD=0.5
COUNTER_MAX_IMAGE_BYTES=10485760

# --- Persistence --------------------------------------------------------
# memory | sql   (prod defaults to sql)
COUNTER_PERSISTENCE=memory
COUNTER_DATABASE_URL=postgresql+psycopg://counter:counter@localhost:5432/object_counter

# --- Models -------------------------------------------------------------
# Defaults to the packaged catalog for the profile; point it at your own file
# to serve internally trained models (see docs/MULTI_MODEL.md).
# COUNTER_MODEL_CATALOG=config/models.example.yaml
# COUNTER_DEFAULT_MODEL=rfcn
COUNTER_PRELOAD_MODELS=false
COUNTER_ARTIFACT_CACHE_DIR=var/models
COUNTER_MAX_IMAGE_SIDE=1024

# --- TensorFlow Serving -------------------------------------------------
COUNTER_TFS_BASE_URL=http://localhost:8501
COUNTER_TFS_TIMEOUT_SECONDS=30

# --- Observability ------------------------------------------------------
COUNTER_LOG_LEVEL=INFO
# json in deployments, text when you are reading it yourself
COUNTER_LOG_FORMAT=text

# --- Tests --------------------------------------------------------------
# Integration and e2e tests use SQLite unless this points at a real database.
# TEST_DATABASE_URL=postgresql+psycopg://counter:counter@localhost:5432/object_counter_test
